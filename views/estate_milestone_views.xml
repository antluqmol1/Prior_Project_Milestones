<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Vista List (anteriormente Tree) para Estate Milestone -->
    <record id="view_estate_milestone_list" model="ir.ui.view">
        <field name="name">estate.milestone.list</field>
        <field name="model">estate.milestone</field>
        <field name="arch" type="xml">
            <list string="Hitos de Proyecto" decoration-danger="overdue==True" decoration-muted="state=='done'">
                <field name="name"/>
                <field name="project_id"/>
                <field name="planned_date"/>
                <field name="responsible_id"/>
                <field name="state"/>
                <field name="overdue" invisible="1"/>
            </list>
        </field>
    </record>

    <!-- Vista Formulario para Estate Milestone -->
    <record id="view_estate_milestone_form" model="ir.ui.view">
        <field name="name">estate.milestone.form</field>
        <field name="model">estate.milestone</field>
        <field name="arch" type="xml">
            <form string="Hito de Proyecto">
                <header>
                     <button name="action_mark_done" type="object" string="Marcar como Realizado" class="oe_highlight" invisible="state == 'done'"/>
                     <field name="state" widget="statusbar" statusbar_visible="pending,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" placeholder="Ej: Cimentación"/></h1>
                    </div>
                    <group>
                        <group>
                            <field name="project_id"/>
                            <field name="responsible_id"/>
                        </group>
                        <group>
                            <field name="planned_date"/>
                            <field name="overdue" readonly="1"/>
                        </group>
                    </group>
                     <notebook>
                        <page string="Tareas Asociadas" name="tasks">
                            <field name="task_ids" mode="list" context="{'default_project_id': project_id}">
                                <!-- Usará la vista list por defecto de project.task -->
                            </field>
                        </page>
                        <page string="Notas Internas" name="internal_notes">
                            <field name="message_follower_ids" widget="mail_followers"/>
                            <field name="activity_ids" widget="mail_activity"/>
                            <field name="message_ids" widget="mail_thread"/>
                        </page>
                    </notebook>
                </sheet>
                 <!-- Chatter -->
                 <div class="oe_chatter">
                    <field name="message_follower_ids"/>
                    <field name="activity_ids"/>
                    <field name="message_ids"/>
                 </div>
            </form>
        </field>
    </record>

    <!-- Vista Kanban para Estate Milestone -->
    <record id="view_estate_milestone_kanban" model="ir.ui.view">
        <field name="name">estate.milestone.kanban</field>
        <field name="model">estate.milestone</field>
        <field name="arch" type="xml">
            <kanban default_group_by="project_id" class="o_kanban_mobile" color="color">
                <!-- Campos necesarios -->
                <field name="name"/>
                <field name="project_id"/>
                <field name="planned_date"/>
                <field name="responsible_id"/>
                <field name="state"/>
                <field name="overdue"/>
                <field name="task_ids"/>
                <field name="color"/>

                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click">
                            <div class="oe_kanban_details">
                                <strong class="o_kanban_record_title"><field name="name"/></strong>
                                <div t-if="record.planned_date.value">
                                    <span class="text-muted">Fecha:</span> <field name="planned_date" widget="date"/>
                                </div>
                                <div t-if="record.task_ids.raw_value.length > 0" class="mt1">
                                    <span class="badge rounded-pill text-bg-primary" title="Número de tareas asociadas">
                                        <i class="fa fa-tasks me-1"/>
                                        <t t-esc="record.task_ids.raw_value.length"/> Tareas
                                    </span>
                                </div>
                                <div t-if="record.responsible_id.value" class="mt1">
                                    <img t-att-src="kanban_image('res.users', 'avatar_128', record.responsible_id.raw_value)" t-att-title="record.responsible_id.value" t-att-alt="record.responsible_id.value" width="24" height="24" class="oe_kanban_avatar float-end"/>
                                </div>
                                <div t-if="record.overdue.raw_value" class="mt1 text-danger fw-bold">
                                    <i class="fa fa-exclamation-triangle" aria-label="Atrasado" title="Atrasado"/> Atrasado
                                </div>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>
        </field>
    </record>

    <!-- Acción de Ventana para Estate Milestone -->
    <record id="action_estate_milestone" model="ir.actions.act_window">
        <field name="name">Hitos de Proyecto</field>
        <field name="res_model">estate.milestone</field>
        <field name="view_mode">list,kanban,form</field>
        <!-- <field name="context">{'search_default_project_id': active_id, 'default_project_id': active_id}</field> -->
        <field name="help" type="html">
          <p class="o_view_nocontent_smiling_face">
            Crea el primer hito para tu proyecto.
          </p><p>
            Define las fases clave, asigna responsables y fechas límite.
          </p>
        </field>
    </record>

</odoo> 